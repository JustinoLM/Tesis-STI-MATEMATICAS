# ============================================
# BASE DE DATOS
# ============================================
# Local (Docker):    postgresql+asyncpg://postgres:postgres@localhost:5432/sti_db
# Producción (Railway): se copia automáticamente desde la variable DATABASE_URL del addon
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sti_db

# ============================================
# SEGURIDAD JWT
# ============================================
# Generar con: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# DEEPSEEK API (LLM remoto)
# ============================================
# Obtener en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL_V3=deepseek-chat        # para enunciados y mensajes motivacionales
DEEPSEEK_MODEL_R1=deepseek-reasoner    # para análisis post-práctica (más lento, más inteligente)

# ============================================
# CORS (Orígenes permitidos en producción)
# ============================================
# En desarrollo no hace falta — se permite todo automáticamente
# En producción poner la URL de Vercel: ["https://tu-app.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# ENTORNO
# ============================================
ENVIRONMENT=development   # cambiar a "production" en Railway
DEBUG=True                # cambiar a False en Railway

# ============================================
# CLOUDINARY (opcional — almacenamiento de videos)
# ============================================
# Solo necesario si usas el módulo de videos
# Obtener en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
