# ============================================
# BASE DE DATOS
# ============================================
# Local (Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/sti_db
# Producción (Supabase): postgresql+asyncpg://user:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sti_db

# ============================================
# SEGURIDAD JWT
# ============================================
# Generar con: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# OLLAMA + DEEPSEEK (LLM Local)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TIMEOUT=30

# ============================================
# CLOUDINARY (Almacenamiento de Assets)
# ============================================
# Obtener de: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# CORS (Orígenes permitidos)
# ============================================
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# ENTORNO
# ============================================
ENVIRONMENT=development
DEBUG=True

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TIMEOUT=60

# Videos Configuration
VIDEO_TEMP_LIFETIME_HOURS=24
MAX_VIDEOS_GUARDADOS=10

# Cloudinary (para generación de videos en 4.5.3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
