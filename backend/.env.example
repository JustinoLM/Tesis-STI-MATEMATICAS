# ============================================
# BASE DE DATOS
# ============================================
# Local (Docker):    postgresql+asyncpg://postgres:postgres@localhost:5432/sti_db
# Producción (Railway): se copia automáticamente desde la variable DATABASE_URL del addon
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sti_db

# ============================================
# SEGURIDAD JWT
# ============================================
# Generar con: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 horas

# Contraseña del panel /admin (se verifica en el backend, nunca en el navegador).
# Si queda vacía, el login de administrador devuelve 503.
# Generar con: openssl rand -base64 24
ADMIN_PASSWORD=
ADMIN_TOKEN_EXPIRE_MINUTES=120

# ============================================
# DEEPSEEK API (LLM remoto)
# ============================================
# Obtener en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL_V3=deepseek-chat        # para enunciados y mensajes motivacionales
DEEPSEEK_MODEL_R1=deepseek-reasoner    # para análisis post-práctica (más lento, más inteligente)

# ============================================
# CORS (Orígenes permitidos en producción)
# ============================================
# Lista JSON de orígenes. Si se omite, se usan los de config.py (localhost y el frontend
# de Vercel). En producción: ["https://tu-app.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# ENTORNO
# ============================================
# Si se omiten, el valor por defecto es producción (docs ocultos, sin eco SQL).
ENVIRONMENT=development   # "production" en Railway (o dejar sin definir)
DEBUG=True                # False en Railway (o dejar sin definir)
# Registros: "json" (una línea JSON por registro) o "text". Vacío = json en producción.
LOG_FORMAT=text
LOG_LEVEL=INFO
