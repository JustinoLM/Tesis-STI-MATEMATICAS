# ============================================
# CONFIGURACIÓN DEL FRONTEND — STI
# ============================================
# Copiar este archivo como .env para desarrollo local

# URL base de la API (sin trailing slash)
# Local:      http://localhost:8000/api
# Producción: https://tu-backend.railway.app/api
VITE_API_BASE_URL=http://localhost:8000/api

# La contraseña del panel /admin ya no vive en el frontend:
# se configura como ADMIN_PASSWORD en el backend (Railway → Variables).
